{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "deploygo",
  "version": "1.1.2",
  "identifier": "com.deploygo.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "deploygo",
        "width": 1024,
        "height": 700,
        "minWidth": 800,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "devCsp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "deploygo",
    "copyright": "MIT License",
    "category": "DeveloperTool",
    "shortDescription": "零停机前端部署桌面工具",
    "longDescription": "基于 Tauri 的零停机部署桌面应用，通过 SSH/SFTP 将前端构建产物部署到远程服务器。",
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "customLanguageFiles": {
          "SimpChinese": "./nsis/Chinese.nsh"
        },
        "displayLanguageSelector": true,
        "headerImage": "./icons/installer/header.bmp",
        "sidebarImage": "./icons/installer/sidebar.bmp",
        "installerIcon": "./icons/icon.ico",
        "uninstallerIcon": "./icons/icon.ico",
        "uninstallerHeaderImage": "./icons/installer/uninstaller-header.bmp",
        "installMode": "currentUser",
        "compression": "lzma"
      },
      "wix": {
        "language": {
          "zh-CN": {
            "localePath": "./wix/zh-CN.wxl"
          }
        }
      }
    },
    "macOS": {
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      },
      "minimumSystemVersion": "10.15"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}

